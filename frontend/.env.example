# Copy this file to .env.local for local development. Do not commit .env.local.
# Cloudflare Pages must provide all three values at build time using HTTPS origins.
VITE_API_URL=http://127.0.0.1:3000
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
# Older/local projects may use VITE_SUPABASE_ANON_KEY instead. Set only one key variable.
# Never place SUPABASE_SERVICE_ROLE_KEY, a database password, or another server secret here.
