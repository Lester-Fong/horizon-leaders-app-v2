{
  "name": "horizon-church-v2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "demo:seed": "npm --prefix backend run demo:seed",
    "demo:reset": "npm --prefix backend run demo:reset",
    "test:e2e": "playwright test",
    "test:e2e:qa005": "playwright test --config=playwright.qa005.config.ts",
    "test:e2e:seeded": "npm run demo:reset && playwright test",
    "supabase": "supabase",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:test": "supabase test db",
    "supabase:types": "supabase gen types typescript --local --schema public > backend/src/types/database.types.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "supabase": "2.114.0"
  }
}
