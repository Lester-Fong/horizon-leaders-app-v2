# Copy this file to .env for local development. Do not commit .env.
# Production requires NODE_ENV, FRONTEND_ORIGIN, SUPABASE_URL, and the service-role key.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
FRONTEND_ORIGIN=http://127.0.0.1:5173
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# Render supplies PORT. Production HOST defaults to 0.0.0.0 when omitted.
# FRONTEND_ORIGIN must be the exact Cloudflare Pages origin (scheme + host + optional port).
# Optional, browser-safe local key used only by Auth integration tests.
# SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Legacy local projects may use SUPABASE_ANON_KEY instead.
